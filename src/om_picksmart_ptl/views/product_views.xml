<odoo>
    <record id="product.product_template_action" model="ir.actions.act_window">
        <field name="name">Products</field>
        <field name="res_model">product.template</field>
        <field name="view_mode">kanban,tree,form</field>
        <field name="target">current</field>
        <field name="context">{'default_filter_to_sell': 1}</field>
    </record>

    <record id="product_template_form_view_picksmart" model="ir.ui.view">
        <field name="name">product.template.form.picksmart</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='inventory']" position="inside">
                <group string="Picksmart PTL Integration">
                    <field name="tag_mac"/>
                    <field name="pickup_quantity"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>